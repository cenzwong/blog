{
  "name": "cenz-blog",
  "version": "1.0.0",
  "description": "Static-first technical knowledge platform",
  "type": "module",
  "scripts": {
    "dev": "node scripts/render-diagrams.mjs && astro dev",
    "build": "node scripts/render-diagrams.mjs && astro build && pnpm run build:search && pnpm run validate:build",
    "build:search": "pagefind --site dist --root-selector '[data-pagefind-body]' --include-characters '._-+/'",
    "validate:build": "node scripts/validate-build.mjs",
    "preview": "astro preview",
    "test": "pnpm run build && pnpm run test:unit && node --test tests/*.test.js && pnpm run test:e2e",
    "check": "astro check",
    "lint": "astro check",
    "setup:browser": "node scripts/ensure-browser.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "perf": "node scripts/measure-performance.mjs",
    "setup:playwright": "node scripts/ensure-playwright.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "~0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@mermaid-js/mermaid-cli": "12.2.0",
    "@playwright/test": "^1.57.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.11",
    "lighthouse": "^13.6.0",
    "pagefind": "^1.6.0",
    "playwright-core": "1.57.0",
    "puppeteer": "25.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "dependencies": {
    "astro": "5.18.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "katex": "^0.16.47",
    "postcss": "^8.5.34",
    "postcss-value-parser": "^4.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.23.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@10.15.0"
}
