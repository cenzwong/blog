{
  "name": "cenz-blog",
  "version": "1.0.0",
  "description": "Static-first technical knowledge platform",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "generate": "node scripts/generate.mjs",
    "build:site": "vite build",
    "build:search": "pagefind --site dist --root-selector '[data-pagefind-body]' --include-characters '._-+/'",
    "build": "npm run ingest && npm run build:site && npm run generate && npm run build:search && npm run validate:build",
    "validate:build": "node scripts/validate-build.mjs",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' && node --test",
    "preview": "vite preview",
    "ingest": "python3 scripts/ingest.py"
  },
  "devDependencies": {
    "marked": "^12.0.1",
    "pagefind": "^1.6.0",
    "vite": "^8.0.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
