---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { publishedArticles } from '../../lib/articles';
import { tagSlug } from '../../lib/routes';
export async function getStaticPaths() {
 const posts = await publishedArticles(); const tags = [...new Set(posts.flatMap(p => p.data.tags))];
 return tags.map(tag => ({params:{tag: tagSlug(tag)},props:{tag,posts:posts.filter(p => p.data.tags.includes(tag))}}));
}
const {tag, posts} = Astro.props;
---
<Base title={tag} description={`Articles about ${tag}.`} canonicalPath={`tags/${tagSlug(tag)}/`}><header class="page-header"><p class="eyebrow">Topic</p><h1>{tag}</h1><p>{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p></header><ArticleList articles={posts}/></Base>
